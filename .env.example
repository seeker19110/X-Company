# Mẫu biến môi trường — KHÔNG ghi giá trị thật vào repo.
# Role ứng dụng (thành viên xc_app_rw; không owner, không BYPASSRLS)
DATABASE_URL=postgres://xc_app:CHANGE_ME@127.0.0.1:5432/xcompany
# Role migration (owner schema) — chỉ dùng cho `npm run db:migrate`
MIGRATE_DATABASE_URL=postgres://xc_owner:CHANGE_ME@127.0.0.1:5432/xcompany
# Bí mật ký phiên/CSRF (≥ 32 byte ngẫu nhiên, vd `openssl rand -base64 48`)
SESSION_SECRET=CHANGE_ME
# Origin công khai (https bật cookie __Host- Secure); kiểm Origin chống CSRF
APP_ORIGIN=https://x-company.example
# Số reverse proxy tin cậy đứng trước ứng dụng (vd nginx = 1): IP client = phần tử thứ N từ phải của X-Forwarded-For.
# 0 = không có proxy → mọi request coi là cùng IP "direct" (giới hạn đăng nhập/biểu mẫu theo email/toàn site) — production
# PHẢI chạy sau proxy và đặt đúng số này.
TRUST_PROXY_HOPS=1
# Công ty sở hữu website công khai (id trong bảng company)
SITE_COMPANY_ID=00000000-0000-0000-0000-000000000000
# Khoá ký QR chấm công: "kid:bí-mật" (≥ 32 byte), cách nhau dấu phẩy; kid đầu dùng để ký, các kid sau chỉ để kiểm khi xoay vòng
QR_SIGNING_KEYS=k1:CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_VALUE
# Thư mục kho tệp private trên đĩa (adapter mặc định — D-005); production: S3-compatible
FILE_STORAGE_DIR=/var/lib/x-company/files

# Log JSON ra stdout: debug|info|warn|error|fatal|silent (mặc định info). Phiên bản dịch vụ ghi vào mỗi dòng log.
LOG_LEVEL=
APP_VERSION=
SHUTDOWN_GRACE_MS=
SHUTDOWN_READY_DELAY_MS=
WORKER_MAX_ATTEMPTS=
WORKER_BATCH_SIZE=
WORKER_POLL_MS=
RETENTION_ENABLED=
RETENTION_INQUIRY_DAYS=
RETENTION_APPLICATION_DAYS=
RETENTION_SESSION_DAYS=
RETENTION_LOGIN_ATTEMPT_DAYS=
RETENTION_OUTBOX_DONE_DAYS=
RETENTION_IDEMPOTENCY_HOURS=
