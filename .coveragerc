# Cấu hình coverage duy nhất của repo. Đo dòng + nhánh, tính cả code chạy trong subprocess
# (hook gọi guard.py, test chạy xt.py/install.py qua CLI) — mỗi tiến trình ghi một file, `coverage combine` gộp.
[run]
branch = True
parallel = True
patch = subprocess
source =
    scripts
    .claude/hooks

[report]
show_missing = True
skip_covered = True
