{
  "name": "x-company",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start -H ${HOST:-127.0.0.1}",
    "lint": "eslint . --max-warnings=0 && npm run -s check:env && npm run -s check:deps",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "scripts/with-test-db.sh node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:file": "scripts/with-test-db.sh node --import tsx --test --test-concurrency=1",
    "coverage": "scripts/coverage.sh",
    "e2e": "scripts/with-test-db.sh scripts/e2e.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:env": "tsx scripts/check-env.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "retention:run": "tsx scripts/retention.ts",
    "crypto:rotate": "tsx scripts/crypto-rotate.ts",
    "crypto:backfill": "tsx scripts/crypto-backfill.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "check:repo-docs": "node scripts/check-repo-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:domains": "tsx scripts/check-domains.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:adr": "tsx scripts/check-adr-immutable.ts",
    "check:tests": "tsx scripts/check-tests.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "check:openapi": "tsx scripts/check-openapi.ts",
    "check:api-breaking": "node scripts/check-api-breaking.mjs",
    "check:authz": "tsx scripts/check-authz-tests.ts",
    "check:arch": "npm run -s check:domains && npm run -s check:routes && npm run -s check:adr && npm run -s check:tests && npm run -s check:authz && npm run -s check:units && npm run -s check:i18n && npm run -s check:encoding && npm run -s check:openapi",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:coverage-baseline": "node scripts/check-coverage-baseline.mjs",
    "check:ci-policy": "node scripts/check-ci-policy.mjs",
    "check:deps": "npm ls --depth=0 > /dev/null",
    "check:units": "node scripts/check-units.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:osv-exceptions": "node scripts/check-osv-exceptions.mjs",
    "check:sql-interpolation": "tsx scripts/check-sql-interpolation.ts",
    "check:sbom": "node scripts/check-sbom.mjs",
    "check:supply-wiring": "node scripts/check-supply-wiring.mjs",
    "notices": "node scripts/gen-third-party-notices.mjs",
    "eol:check": "node scripts/eol-check.mjs",
    "check:supply-chain": "npm run -s check:licenses && npm run -s check:osv-exceptions && node scripts/gen-third-party-notices.mjs --check && npm run -s check:sql-interpolation && npm run -s check:sbom && npm run -s check:supply-wiring && python3 .xtemplates/scripts/xt.py ci-check .github/workflows",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lighthouse": "scripts/with-test-db.sh scripts/lighthouse.sh",
    "dast": "scripts/with-test-db.sh scripts/dast.sh",
    "dast:probes": "scripts/with-test-db.sh node scripts/dast-baseline.mjs",
    "perf:load": "scripts/with-test-db.sh node scripts/perf-load.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "check:alerts": "node scripts/check-alerts.mjs",
    "alerts:drill": "scripts/with-test-db.sh tsx scripts/alerts-drill.ts",
    "ops:stack:drill": "scripts/with-test-db.sh node scripts/ops-stack-drill.mjs",
    "reports:refresh": "XC_REPORT_DIR=. npm run -s dast:probes && XC_REPORT_DIR=. npm run -s perf:load && XC_REPORT_DIR=. npm run -s ops:stack:drill",
    "backup": "scripts/backup.sh",
    "backup:drill": "scripts/restore-drill.sh",
    "kms:drill": "scripts/with-test-db.sh scripts/kms-dev.sh run -- tsx scripts/kms-rotation-drill.ts",
    "tools:install": "node scripts/tools/install-tool.mjs install",
    "backup:offsite": "scripts/backup-offsite.sh",
    "backup:offsite:drill": "scripts/restore-offsite-drill.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "markdown-it": "15.0.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "npm@10.9.4"
}
