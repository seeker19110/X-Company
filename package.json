{
  "name": "x-company",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start -H ${HOST:-127.0.0.1}",
    "lint": "eslint . --max-warnings=0 && npm run -s check:env",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "scripts/with-test-db.sh node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:file": "scripts/with-test-db.sh node --import tsx --test --test-concurrency=1",
    "coverage": "scripts/coverage.sh",
    "e2e": "scripts/with-test-db.sh scripts/e2e.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:env": "tsx scripts/check-env.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "check:repo-docs": "node scripts/check-repo-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:domains": "tsx scripts/check-domains.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:adr": "tsx scripts/check-adr-immutable.ts",
    "check:tests": "tsx scripts/check-tests.ts",
    "check:authz": "tsx scripts/check-authz-tests.ts",
    "check:arch": "npm run -s check:domains && npm run -s check:routes && npm run -s check:adr && npm run -s check:tests && npm run -s check:authz"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "markdown-it": "14.3.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2"
  }
}
