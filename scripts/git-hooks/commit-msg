#!/usr/bin/env bash
# xc-managed-hook — subject commit theo Conventional Commits, ≤ 72 ký tự (BASE-REPO-005); merge/revert của git được phép.
set -euo pipefail
subject="$(head -n1 "$1")"
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*$'
if ! [[ "$subject" =~ $re ]]; then echo "commit-msg: subject phải theo Conventional Commits: $subject" >&2; exit 1; fi
len=$(printf '%s' "$subject" | wc -m)
if [ "$len" -gt 72 ]; then echo "commit-msg: subject $len ký tự > 72" >&2; exit 1; fi
